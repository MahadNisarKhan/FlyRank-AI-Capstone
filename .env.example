# ── App ───────────────────────────────────────────────────────
# Set this to your Vercel preview/production URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Database ──────────────────────────────────────────────────
# MySQL connection string (PlanetScale / Railway / Render)
DATABASE_URL=mysql://user:password@host:3306/quasaredu

# ── Auth ──────────────────────────────────────────────────────
# Run: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_secret

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── Email (Gmail SMTP) ────────────────────────────────────────
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password_not_account_password
